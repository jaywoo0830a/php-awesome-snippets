  "Method (union param types, PHP 8.0+)": {
    "prefix": "m.union",
    "body": [
      "public function ${1:setValue}(int|string|array \\$${2:value}): void",
      "{",
      "\t${0:// handle union types...}",
      "}"
    ],
    "description": "Union-typed parameter"
  },
  "Method (nullable param & return)": {
    "prefix": "m.nullable",
    "body": [
      "public function ${1:maybeFind}(?string \\$${2:id}): ?${3:Item}",
      "{",
      "\t${0:// return null when not found}",
      "}"
    ],
    "description": "Nullable parameter and return"
  },
  "Method (intersection param types, PHP 8.1+)": {
    "prefix": "m.intersection",
    "body": [
      "public function ${1:consume}(\\Traversable&\\Countable \\$${2:collection}): int",
      "{",
      "\treturn count(iterator_to_array(\\$${2:collection}));",
      "}"
    ],
    "description": "Intersection types for param"
  },
  "Method (never return type, PHP 8.1+)": {
    "prefix": "m.never",
    "body": [
      "public function ${1:panic}(string \\$${2:message}): never",
      "{",
      "\tthrow new ${3:RuntimeException}(\\$${2:message});",
      "}"
    ],
    "description": "Method that never returns"
  },
  "Method (static return type, fluent API)": {
    "prefix": "m.staticret",
    "body": [
      "public function ${1:with}(string \\$${2:key}, mixed \\$${3:value}): static",
      "{",
      "\t$this->\\$${2:key} = \\$${3:value};",
      "\treturn $this;",
      "}"
    ],
    "description": "Fluent API with static return"
  },
  "Method (self return)": {
    "prefix": "m.selfret",
    "body": [
      "public function ${1:reset}(): self",
      "{",
      "\t${0:// re-init and return $this}",
      "\treturn $this;",
      "}"
    ],
    "description": "Return self"
  },
  "Method (parent return)": {
    "prefix": "m.parentret",
    "body": [
      "public function ${1:factory}(): parent",
      "{",
      "\t${0:// return parent instance}",
      "}"
    ],
    "description": "Return parent (rare; for covariant returns)"
  },

  "Method with attribute (PHP 8.0+)": {
    "prefix": "m.attr",
    "body": [
      "#[${1:Route}('${2:GET}', '${3:/ping}')]",
      "public function ${4:ping}(): array",
      "{",
      "\treturn ['status' => 'ok'];",
      "}"
    ],
    "description": "Method decorated with attribute"
  },
  "Method (throw expression, PHP 8.0+)": {
    "prefix": "m.throwexpr",
    "body": [
      "public function ${1:requireId}(array \\$${2:data}): int",
      "{",
      "\t\\$id = \\$${2:data}['${3:id}'] ?? throw new ${4:InvalidArgumentException}('Missing ${3:id}');",
      "\treturn (int) \\$id;",
      "}"
    ],
    "description": "Use throw as an expression inside method"
  },
  "Magic __invoke": {
    "prefix": "m.invoke",
    "body": [
      "public function __invoke(${1:Type} \\$${2:arg}): ${3:mixed}",
      "{",
      "\t${0:// callable object entrypoint}",
      "}"
    ],
    "description": "Magic method __invoke"
  },
  "Magic __toString": {
    "prefix": "m.tostr",
    "body": [
      "public function __toString(): string",
      "{",
      "\t${0:// return string representation}",
      "}"
    ],
    "description": "Magic method __toString"
  },
  "Magic __get / __set": {
    "prefix": "m.getset",
    "body": [
      "public function __get(string \\$${1:name}): mixed",
      "{",
      "\t${2:// dynamic getter}",
      "\treturn null;",
      "}",
      "",
      "public function __set(string \\$${1:name}, mixed \\$${3:value}): void",
      "{",
      "\t${0:// dynamic setter}",
      "}"
    ],
    "description": "Magic property accessors"
  }
