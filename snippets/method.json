{
  "Class constructor": {
    "prefix": "pubc",
    "body": [
      "public function __construct(${1:Type} \\$${2:arg})",
      "{",
      "\t${0:// init...}",
      "}"
    ],
    "description": "Public constructor"
  },
  "Class private constructor": {
    "prefix": "pric",
    "body": [
      "private function __construct(${1:Type} \\$${2:arg})",
      "{",
      "\t${0:// for static factories}",
      "}"
    ],
    "description": "Private constructor (factory pattern)"
  },
  "Class protected constructor": {
    "prefix": "proc",
    "body": [
      "protected function __construct(${1:Type} \\$${2:arg})",
      "{",
      "\t${0:// for inheritance}",
      "}"
    ],
    "description": "Protected constructor"
  },

