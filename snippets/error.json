{
  "Try ... catch": {
    "prefix": "tryc",
    "body": [
      "try {",
      "\t${1:// code...}",
      "} catch (${2:\\Throwable} \\$${3:e}) {",
      "\t${0:// handle error}",
      "}"
    ],
    "description": "Try catch block"
  },
  "Try ... catch ... finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "\t${1:// code...}",
      "} catch (${2:\\Throwable} \\$${3:e}) {",
      "\t${4:// handle error}",
      "} finally {",
      "\t${0:// cleanup}",
      "}"
    ],
    "description": "Try catch finally block"
  },
  "Catch": {
    "prefix": "cat",
    "body": [
      "catch (${1:\\Throwable} \\$${2:e}) {",
      "\t${0:// code...}",
      "}"
    ],
    "description": "Catch block"
  },
  "Finally": {
    "prefix": "fy",
    "body": [
      "finally {",
      "\t${0:// code...}",
      "}"
    ],
    "description": "Finally block"
  },
  "Throw new Exception": {
    "prefix": "thr",
    "body": [
      "throw new ${1:Some}Exception(\"${2:Error statement}\");"
    ],
    "description": "Throw new exception statement"
  },

  "Multi-catch with union (PHP 8.0+)": {
    "prefix": "trymc",
    "body": [
      "try {",
      "\t${1:// code...}",
      "} catch (${2:InvalidArgumentException}|${3:RuntimeException} \\$${4:e}) {",
      "\t${0:// handle expected errors}",
      "}"
    ],
    "description": "Union type multi-catch (8.0+)"
  },
  "Rethrow exception": {
    "prefix": "rethr",
    "body": [
      "catch (${1:\\Throwable} \\$${2:e}) {",
      "\tthrow; // rethrow without losing original trace",
      "}"
    ],
    "description": "Rethrow caught exception"
  },
  "Throw expression with null coalesce (PHP 8.0+)": {
    "prefix": "thrnco",
    "body": [
      "$${1:value} = $${2:data}['${3:key}'] ?? throw new ${4:InvalidArgumentException}(\"${5:Missing key}\");"
    ],
    "description": "Throw as expression using ?? (8.0+)"
  },
  "Throw expression (ternary) (PHP 8.0+)": {
    "prefix": "thrtern",
    "body": [
      "${1:condition} ? ${2:okExpr} : throw new ${3:RuntimeException}(\"${4:Error}\");"
    ],
    "description": "Throw inside ternary expression (8.0+)"
  },
  "Custom exception class": {
    "prefix": "exclass",
    "body": [
      "class ${1:CustomException} extends \\Exception {",
      "\tpublic function __construct(string $message = \"${2:Default message}\", int $code = 0, ?\\Throwable $previous = null) {",
      "\t\tparent::__construct($message, $code, $previous);",
      "\t}",
      "}"
    ],
    "description": "Define a custom exception class"
  },
  "DomainException with readonly property (PHP 8.1+)": {
    "prefix": "exreadonly",
    "body": [
      "final class ${1:DomainException} extends \\RuntimeException {",
      "\tpublic function __construct(public readonly string $context, string $message = \"${2:Domain error}\") {",
      "\t\tparent::__construct($message);",
      "\t}",
      "}"
    ],
    "description": "Custom exception carrying readonly context (8.1+)"
  }
}
